{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.scicloj/kindly-advice {:mvn/version "1-beta17"}
        io.github.openhtmltopdf/openhtmltopdf-java2d {:mvn/version "1.1.86"}
        io.github.nextjournal/markdown {:mvn/version "0.7.225"}
        org.apache.commons/commons-compress {:mvn/version "1.28.0"}
        org.clojure/data.json {:mvn/version "2.5.1"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      ;; Optional at run time; needed to test charts.
                      org.scicloj/plotje {:mvn/version "0.15.0"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
